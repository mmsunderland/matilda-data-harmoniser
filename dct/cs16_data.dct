dictionary {
        float   survey            `"Year of survey"'
        byte    sex     :MF       `"Sex of student"'
        byte    agecat            `"Age at baseline - categorical"'
        float   agecon            `"Age at baseline - continuous"'
        byte    school            `"School"'
        float   schooltype:STYPE    `"Type of school"'
_newline
        float   state   :STATE    `"Australian state"'
        byte    group2cat:GROUP2CAT`"Control (0) vs Intervention (1)"'
        float   group4cat:GROUP4CAT`"Control (0) vs Intervention (1,2,3)"'
        byte    peerdrink:PEER     `"How many friends drink"'
_newline
        byte    peerdrunk:PEER     `"How many friends drink to get drunk"'
        float   guidelines:NOYES    `"T1 Guidelines <15 years correct answer"'
        float   mostkids:NOYES    `"T1 Most kids my age correct answer"'
        double  ak                `"Total alcohol knowledge score"'
        float   full6m  :NOYES    `"T1 Full drink past 6 months"'
        float   binge6m :NOYES    `"T1 Binge past 6 months"'
_newline
        byte    nervous :K6ITEM   `"T1 K6 nervous"'
        byte    hopeless:K6ITEM   `"T1 K6 hopeless"'
        byte    restless:K6ITEM   `"T1 K6 restless"'
_newline
        byte    depressed:K6ITEM   `"T1 K6 depressed"'
        byte    effort  :K6ITEM   `"T1 K6 effort"'
        byte    worthless:K6ITEM   `"T1 K6 worthless"'
        float   k6                `"Total K6 score"'
_newline
        float   k6cat8  :NOYES    `"K6>=8"'
        float   k6cat13 :NOYES    `"K6>=13"'
        float   k6cat19 :NOYES    `"K6>=19"'
        float   nervouscat:NOYES    `"Nervous at least some of the time"'
        float   hopelesscat:NOYES    `"Hopeless at least some of the time"'
        float   restlesscat:NOYES    `"Restless at least some of the time"'
        float   depressedcat:NOYES    `"Depressed at least some of the time"'
_newline
        float   effortcat:NOYES    `"Effort at least some of the time"'
        float   worthlesscat:NOYES    `"Worthless at least some of the time"'
}
